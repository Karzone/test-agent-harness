{
  "description": "A scripted tester that strays: it tries to leave the site and to click a forbidden action before doing the job.",
  "attempts": [
    [
      {
        "calls": [
          {
            "tool": "browser_snapshot",
            "args": {}
          }
        ]
      },
      {
        "say": "Look something up elsewhere first.",
        "calls": [
          {
            "tool": "browser_navigate",
            "args": {
              "url": "https://example.com/"
            }
          }
        ]
      },
      {
        "say": "Try the checkout to be thorough.",
        "calls": [
          {
            "tool": "browser_click",
            "args": {
              "selector": "[data-testid='checkout']"
            }
          }
        ]
      },
      {
        "say": "Add Coffee to the basket.",
        "calls": [
          {
            "tool": "browser_click",
            "args": {
              "selector": "[data-testid='add-coffee']"
            }
          }
        ]
      },
      {
        "calls": [
          {
            "tool": "record_result",
            "args": {
              "criterion_id": "AC1",
              "status": "pass",
              "selector": "[data-testid='basket-total']"
            }
          }
        ]
      },
      {
        "calls": [
          {
            "tool": "record_result",
            "args": {
              "criterion_id": "AC3",
              "status": "pass",
              "selector": "[data-testid='basket-count']",
              "note": "Count went from 0 to 1 after adding one item."
            }
          }
        ]
      },
      {
        "say": "Apply the discount code.",
        "calls": [
          {
            "tool": "browser_fill",
            "args": {
              "selector": "[data-testid='discount-code']",
              "value": "SAVE10"
            }
          },
          {
            "tool": "browser_click",
            "args": {
              "selector": "[data-testid='apply-discount']"
            }
          }
        ]
      },
      {
        "calls": [
          {
            "tool": "record_result",
            "args": {
              "criterion_id": "AC2",
              "status": "pass",
              "selector": "[data-testid='basket-total']"
            }
          }
        ]
      },
      {
        "say": "The total is not what the story expects. Record what the page shows.",
        "calls": [
          {
            "tool": "record_result",
            "args": {
              "criterion_id": "AC2",
              "status": "fail",
              "selector": "[data-testid='basket-total']",
              "note": "Expected 10% off £3.00."
            }
          }
        ]
      },
      {
        "say": "All acceptance criteria have been checked."
      }
    ]
  ]
}
