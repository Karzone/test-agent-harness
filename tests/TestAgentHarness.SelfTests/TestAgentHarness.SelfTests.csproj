<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the harness itself. A plain console app with no test-framework
    packages, so it runs anywhere the .NET SDK does (see the README for the command).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TestAgentHarness.Core\TestAgentHarness.Core.csproj" />
  </ItemGroup>

</Project>
